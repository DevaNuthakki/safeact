# SafeAct local development only.
# Never use these settings for production.
SAFEACT_DEV_DB_PORT=55432
SAFEACT_DEV_DB_PASSWORD=replace-with-local-secret
# Redis broker (deploy/compose.yaml). The password must be alphanumeric.
SAFEACT_DEV_REDIS_PORT=56379
SAFEACT_DEV_REDIS_PASSWORD=replacewithlocalalphanumericsecret
