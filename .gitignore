.stack-logs/

# Calibration raw output (~340 MB) stays in the working tree for the full run's digest
# re-check; copies and digests: ~/safeact-evidence, docs/phase-e/evidence-index.md.
docs/phase-e/qual-v1/calibration/*/raw.jsonl
# Full qualification raw output (~1.2 GB): compressed copy in ~/safeact-evidence, to be a
# GitHub Release asset; digests in docs/phase-e/qual-v1/full/outside-repo.json.
docs/phase-e/qual-v1/full/raw.jsonl
# Diagnostic rerun raw output: compressed copy in ~/safeact-evidence; digests in
# docs/phase-e/qual-v1/diagnostics/outside-repo.json.
docs/phase-e/qual-v1/diagnostics/raw.jsonl

# Stripe test-mode demo (deploy/demo/stripe_demo.py): fixture PaymentIntent ids
# and the call log (request ids, never the key).
.demo-stripe.json
.demo-stripe-*
