{
  "components": {
    "schemas": {
      "Admitted": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "created"
        ],
        "title": "Admitted",
        "type": "object"
      },
      "CancelResult": {
        "properties": {
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "undone": {
            "default": false,
            "description": "Always false: a cancellation never undoes a remote action that may have been dispatched.",
            "title": "Undone",
            "type": "boolean"
          }
        },
        "required": [
          "outcome",
          "state",
          "seq"
        ],
        "title": "CancelResult",
        "type": "object"
      },
      "CreateWorkflow": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Case Id",
            "type": "string"
          },
          "charge_contract": {
            "default": "v1",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Charge Contract",
            "type": "string"
          },
          "compensation_contract": {
            "default": "v1",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Compensation Contract",
            "type": "string"
          },
          "crm_account_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Crm Account Id",
            "type": "string"
          },
          "customer_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Customer Id",
            "type": "string"
          },
          "fee_minor": {
            "exclusiveMinimum": 0.0,
            "maximum": 10000000.0,
            "title": "Fee Minor",
            "type": "integer"
          },
          "order_contract": {
            "default": "v1",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Order Contract",
            "type": "string"
          },
          "payments_account_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Payments Account Id",
            "type": "string"
          },
          "request_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$",
            "title": "Request Key",
            "type": "string"
          },
          "sku": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "request_key",
          "customer_id",
          "case_id",
          "sku",
          "fee_minor",
          "payments_account_id",
          "crm_account_id"
        ],
        "title": "CreateWorkflow",
        "type": "object"
      },
      "Decide": {
        "additionalProperties": false,
        "properties": {
          "binding_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Binding Digest",
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "decision_key": {
            "description": "Client-generated once per decision; a repeated click with the same key returns the stored decision.",
            "format": "uuid",
            "title": "Decision Key",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "decision",
          "binding_digest",
          "decision_key"
        ],
        "title": "Decide",
        "type": "object"
      },
      "GrantView": {
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "connector_id": {
            "title": "Connector Id",
            "type": "string"
          },
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "provider_account_id": {
            "title": "Provider Account Id",
            "type": "string"
          },
          "resource_id": {
            "title": "Resource Id",
            "type": "string"
          }
        },
        "required": [
          "connector_id",
          "provider_account_id",
          "action_type",
          "resource_id",
          "contract_version"
        ],
        "title": "GrantView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/PrincipalView"
          }
        },
        "required": [
          "principal",
          "csrf_token"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "OperationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_before": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before"
          },
          "next_before_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before Id"
          }
        },
        "required": [
          "items",
          "next_before",
          "next_before_id"
        ],
        "title": "OperationPage",
        "type": "object"
      },
      "OperationSummary": {
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "connector_id": {
            "title": "Connector Id",
            "type": "string"
          },
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "operation_id": {
            "format": "uuid",
            "title": "Operation Id",
            "type": "string"
          },
          "request_key": {
            "title": "Request Key",
            "type": "string"
          },
          "requested_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested By"
          },
          "resource_id": {
            "title": "Resource Id",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "unknown_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unknown Reason"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "request_key",
          "action_type",
          "resource_id",
          "connector_id",
          "contract_version",
          "state",
          "seq",
          "unknown_reason",
          "requested_by",
          "created_at",
          "updated_at"
        ],
        "title": "OperationSummary",
        "type": "object"
      },
      "PrincipalView": {
        "properties": {
          "demo": {
            "title": "Demo",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "principal_id": {
            "title": "Principal Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "session_expires_at": {
            "format": "date-time",
            "title": "Session Expires At",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "tenant_id",
          "username",
          "display_name",
          "kind",
          "roles",
          "demo",
          "session_expires_at"
        ],
        "title": "PrincipalView",
        "type": "object"
      },
      "ProposeAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "REVERIFY",
              "PROTECTED_RETRY",
              "ATTEST_APPLIED"
            ],
            "title": "Action",
            "type": "string"
          },
          "attested_reference": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ATTEST_APPLIED only: the provider's reference for the applied effect. Never proof of non-application.",
            "title": "Attested Reference"
          },
          "rationale": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "action",
          "rationale"
        ],
        "title": "ProposeAction",
        "type": "object"
      },
      "SubmitAction": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "enum": [
              "refund_payment",
              "create_replacement_order",
              "send_refund_confirmation",
              "refund_stripe_test_payment"
            ],
            "title": "Action Type",
            "type": "string"
          },
          "contract_version": {
            "default": "v1",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Contract Version",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "provider_account_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "title": "Provider Account Id",
            "type": "string"
          },
          "request_key": {
            "description": "Client-generated once per form; resubmitting the same key returns the same operation.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$",
            "title": "Request Key",
            "type": "string"
          }
        },
        "required": [
          "request_key",
          "action_type",
          "provider_account_id",
          "payload"
        ],
        "title": "SubmitAction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowAdmitted": {
        "properties": {
          "charge_operation_id": {
            "format": "uuid",
            "title": "Charge Operation Id",
            "type": "string"
          },
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "workflow_id": {
            "format": "uuid",
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "workflow_id",
          "charge_operation_id",
          "created"
        ],
        "title": "WorkflowAdmitted",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SafeAct API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions": {
      "get": {
        "operationId": "list_actions_actions_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Z_]{1,32}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "connector",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Connector"
            }
          },
          {
            "in": "query",
            "name": "unresolved",
            "required": false,
            "schema": {
              "default": false,
              "title": "Unresolved",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "before_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Actions",
        "tags": [
          "actions"
        ]
      },
      "post": {
        "operationId": "submit_actions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admitted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit",
        "tags": [
          "actions"
        ]
      }
    },
    "/actions/{operation_id}": {
      "get": {
        "description": "Full investigation view. Provider text is untrusted: render as text.",
        "operationId": "get_action_actions__operation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Action",
        "tags": [
          "actions"
        ]
      }
    },
    "/actions/{operation_id}/cancel": {
      "post": {
        "operationId": "cancel_actions__operation_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel",
        "tags": [
          "actions"
        ]
      }
    },
    "/actions/{operation_id}/proposals": {
      "post": {
        "operationId": "propose_actions__operation_id__proposals_post",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Propose",
        "tags": [
          "review"
        ]
      }
    },
    "/actions/{operation_id}/verification-requests": {
      "post": {
        "description": "Ask for one more lookup now (investigator, no approval needed).\n\nLookup-only and inside the contract's bounds: after the check\ninterval since the last lookup, before the post-escalation horizon,\na few per escalation. Beyond them, propose REVERIFY for a reviewer.",
        "operationId": "request_verification_actions__operation_id__verification_requests_post",
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Operation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Verification",
        "tags": [
          "review"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sign-in failed (one fixed body)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrincipalView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/events": {
      "get": {
        "operationId": "events_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-9]{1,20}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
